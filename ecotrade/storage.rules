rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024; // maks 10 MB
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
          && request.resource.size < 100 * 1024 * 1024; // maks 100 MB
    }

    // ── Profile Photos ──────────────────────────────────────────────────────
    // /profile_photos/{uid}.jpg
    match /profile_photos/{fileName} {
      // User bisa read foto profil siapa saja (untuk ditampilkan di app)
      allow read: if isAuthenticated();
      // Hanya pemilik yang bisa upload/replace fotonya sendiri
      allow write: if isAuthenticated() && fileName == request.auth.uid + '.jpg' && isValidImage();
    }

    // ── Product Images ──────────────────────────────────────────────────────
    // /product_images/{uid}/{filename}
    match /product_images/{uid}/{fileName} {
      // Semua user authenticated bisa melihat foto produk
      allow read: if isAuthenticated();
      // Hanya seller (pemilik) yang bisa upload foto produknya
      allow write: if isOwner(uid) && isValidImage();
    }

    // ── Seller Registration Documents ───────────────────────────────────────
    // /seller_registrations/{uid}/{fileName}
    match /seller_registrations/{uid}/{fileName} {
      // Hanya pemilik yang bisa baca & upload dokumen registrasinya
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid) && isValidImage();
    }

    // ── KYC Documents (KTP & Selfie) ────────────────────────────────────────
    // /kyc/{uid}/{fileName}
    match /kyc/{uid}/{fileName} {
      // Hanya pemilik yang bisa baca & upload dokumen KYC-nya
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid) && isValidImage();
    }

    // ── Courier Documents (KTP & SIM) ───────────────────────────────────────
    // /courier_documents/{uid}/{fileName}
    match /courier_documents/{uid}/{fileName} {
      // Hanya pemilik yang bisa baca & upload dokumen kurir-nya
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid) && isValidImage();
    }

    // ── Payment Proofs ──────────────────────────────────────────────────────
    // /payment_proofs/{uid}/{fileName}
    match /payment_proofs/{uid}/{fileName} {
      // Hanya buyer pemilik yang bisa upload & baca bukti transfernya sendiri
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid) && isValidImage();
    }

    // ── Review Photos ───────────────────────────────────────────────────────
    // /review_photos/{productId}/{orderId}/{fileName}
    match /review_photos/{productId}/{orderId}/{fileName} {
      // Semua user authenticated bisa melihat foto review (tampil di halaman produk)
      allow read: if isAuthenticated();
      // Hanya user yang login bisa upload foto review
      allow write: if isAuthenticated() && isValidImage();
    }

    // ── Review Videos ───────────────────────────────────────────────────────
    // /review_videos/{productId}/{orderId}/{fileName}
    match /review_videos/{productId}/{orderId}/{fileName} {
      // Semua user authenticated bisa melihat video review
      allow read: if isAuthenticated();
      // Hanya user yang login bisa upload video review, maks 100 MB
      allow write: if isAuthenticated() && isValidVideo();
    }

    // ── Return Photos ───────────────────────────────────────────────────────
    // /return_photos/{orderId}/{fileName}
    match /return_photos/{orderId}/{fileName} {
      // Hanya user yang login bisa baca & upload foto retur
      // (buyer & seller masing-masing perlu akses baca untuk proses review admin)
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated() && isValidImage();
    }

  }
}
