rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: admin check (custom claim ATAU roles di Firestore) ────────────
    // Menggunakan dua metode sekaligus agar tidak bergantung pada satu cara saja:
    // 1. Firebase Auth custom claim: {admin: true}
    // 2. Firestore users/{uid}.roles berisi 'admin'
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['admin']))
      );
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin();
      // Mengizinkan kurir untuk menambahkan refundBalance
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refundBalance', 'updatedAt']);
    }

    // ── Usernames ─────────────────────────────────────────────────────────────
    match /usernames/{username} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Courier Applications ──────────────────────────────────────────────────
    match /courier_applications/{uid} {
      allow read:         if request.auth != null && request.auth.uid == uid;
      allow create:       if request.auth != null && request.auth.uid == uid;
      allow update:       if request.auth != null && request.auth.uid == uid;
      allow read, update: if isAdmin();
      // Seller bisa baca semua courier (untuk assign otomatis)
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['seller']);
    }

    // ── Seller Applications ───────────────────────────────────────────────────
    match /seller_applications/{uid} {
      allow read:                 if request.auth != null && request.auth.uid == uid;
      allow create:               if request.auth != null && request.auth.uid == uid;
      allow read, create, update: if isAdmin();
    }

    // ── Products ──────────────────────────────────────────────────────────────
    match /products/{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Seller Registrations (legacy) ─────────────────────────────────────────
    match /seller_registrations/{document=**} {
      allow read:           if request.auth != null;
      allow create:         if request.auth != null
                            && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── Carts ─────────────────────────────────────────────────────────────────
    match /carts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    // Admin bisa baca & update SEMUA orders (verifikasi payment, refund, dll.)
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid;

      // Admin: akses penuh ke semua orders
      allow read, update: if isAdmin();

      // Pelaku terkait: bisa baca & update order mereka masing-masing
      allow read:   if request.auth != null
                    && (resource.data.buyerId    == request.auth.uid
                        || resource.data.sellerId  == request.auth.uid
                        || resource.data.courierId == request.auth.uid
                        || resource.data.get('returnCourierId', '') == request.auth.uid
                        || resource.data.sellerIds.hasAny([request.auth.uid]));
      allow update: if request.auth != null
                    && (resource.data.buyerId   == request.auth.uid
                        || resource.data.sellerId  == request.auth.uid
                        || resource.data.courierId == request.auth.uid
                        || resource.data.get('returnCourierId', '') == request.auth.uid
                        || resource.data.sellerIds.hasAny([request.auth.uid]));
    }

    // ── Payments ──────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Semua user yang login bisa baca & buat payment (buyer upload bukti, admin verifikasi)
      allow read, create: if request.auth != null;
      // Admin bisa update payment; buyer pemilik juga bisa update miliknya
      allow update: if isAdmin();
      allow update: if request.auth != null && resource.data.buyerId == request.auth.uid;
    }

    // ── Reviews ───────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:           if request.auth != null;
      allow create:         if request.auth != null
                            && request.resource.data.buyerId == request.auth.uid;
      allow update:         if request.auth != null
                            && (resource.data.buyerId == request.auth.uid 
                                || resource.data.get('sellerId', '') == request.auth.uid
                                || get(/databases/$(database)/documents/products/$(resource.data.productId)).data.sellerId == request.auth.uid);
      allow delete:         if request.auth != null
                            && resource.data.buyerId == request.auth.uid;
    }

    // ── Returns ───────────────────────────────────────────────────────────────
    // Koleksi retur produk: buyer buat dokumen, admin/seller bisa baca & update.
    match /returns/{returnId} {
      allow read:   if request.auth != null
                    && (resource.data.buyerId == request.auth.uid || isAdmin()
                        || resource.data.sellerIds.hasAny([request.auth.uid])
                        || resource.data.get('returnCourierId', '') == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin()
                    || (request.auth != null
                        && (resource.data.sellerIds.hasAny([request.auth.uid])
                            || resource.data.get('returnCourierId', '') == request.auth.uid));
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
                          && (resource.data.recipientId == request.auth.uid
                              || resource.data.recipientId == 'ADMIN_ALL'
                              || isAdmin());
    }

    // ── Payouts ───────────────────────────────────────────────────────────────
    // Field yang dipakai: userId (bukan sellerId) — berlaku untuk buyer & seller.
    match /payouts/{payoutId} {
      allow read:   if request.auth != null
                    && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ── Fallback: authenticated users (read-only untuk koleksi lain) ──────────
    match /{document=**} {
      allow read: if request.auth != null;
    }
  }
}